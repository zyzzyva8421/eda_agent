# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=eda_agent
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=eda_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MiniMax LLM ──────────────────────────────────────────────────────────────
MINIMAX_API_KEY=sk-cp-HLVbwFFa2LIsMbKRSsm-qmUTFYS9GvvclT-MyVohuoEMTDY87aL_4UkuNZRqpvZVzQzBav1CaciE1lz9aVVdwc6kDvfETiuZSYj4JsJejdCCYoqJxig4drs
# MINIMAX_GROUP_ID=488146745658241033
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-M2.5

# ── ORFS backend ──────────────────────────────────────────────────────────────
ORFS_ROOT=${HOME}/OpenROAD-flow-scripts
ORFS_MAKE_JOBS=4

# ── Innovus backend (SSH) ─────────────────────────────────────────────────────
INNOVUS_SSH_HOST=192.168.58.10
INNOVUS_SSH_USER=host
INNOVUS_SSH_PORT=22
INNOVUS_SSH_PASSWORD=
INNOVUS_BIN=/opt/cadance/INNOVUS181/bin/innovus
INNOVUS_REMOTE_WORKDIR=/home/host
INNOVUS_TIMEOUT_SEC=7200

# ── Parquet archive ───────────────────────────────────────────────────────────
PARQUET_ARCHIVE_DIR=/data/archive

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_SECRET_KEY=change_me_to_random_secret_256bits
API_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── LLM backend selection ─────────────────────────────────────────────────
# Options: "minimax" (default), "ollama", "vllm"
LLM_BACKEND=vllm

# Used when llm_backend == "ollama"
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Used when llm_backend == "vllm"
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen2.5-Coder-3B-Instruct-AWQ

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
LANGSMITH_API_KEY=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
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=eda_agent
LANGSMITH_ENABLED=true

# ── pgAdmin (docker-compose only) ─────────────────────────────────────────────
PGADMIN_EMAIL=admin@eda.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
