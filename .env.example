# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=eda_agent
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=eda_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MiniMax LLM ──────────────────────────────────────────────────────────────
MINIMAX_API_KEY=sk-cp-HLVbwFFa2LIsMbKRSsm-qmUTFYS9GvvclT-MyVohuoEMTDY87aL_4UkuNZRqpvZVzQzBav1CaciE1lz9aVVdwc6kDvfETiuZSYj4JsJejdCCYoqJxig4drs
MINIMAX_GROUP_ID=488146745658241033
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=MiniMax-Text-01

# ── ORFS backend ──────────────────────────────────────────────────────────────
ORFS_ROOT=${HOME}/OpenROAD-flow-scripts
ORFS_MAKE_JOBS=4

# ── Innovus backend (SSH) ─────────────────────────────────────────────────────
INNOVUS_SSH_HOST=192.168.58.10
INNOVUS_SSH_USER=host
INNOVUS_SSH_PORT=22
INNOVUS_SSH_PASSWORD=
INNOVUS_BIN=/opt/cadance/INNOVUS181/bin/innovus
INNOVUS_REMOTE_WORKDIR=/home/host
INNOVUS_TIMEOUT_SEC=7200

# ── Parquet archive ───────────────────────────────────────────────────────────
PARQUET_ARCHIVE_DIR=/data/archive

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_SECRET_KEY=change_me_to_random_secret_256bits
API_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CUSTOM_TOOLS_FILE=
CUSTOM_TOOLS_ALLOWLIST=
CUSTOM_TOOLS_DENYLIST=
CUSTOM_TOOLS_ENABLE_ENTRYPOINTS=true
CUSTOM_TOOLS_ENTRYPOINT_GROUP=eda_agent.custom_tools

# ── LLM tool calling mode ─────────────────────────────────────────────────────
# "native"  – send tools/tool_choice in the API payload (default; MiniMax,
#             vLLM with a proper chat template that renders {{ tools }})
# "prompt"  – inject tool definitions into the system prompt and parse
#             <tool_call> JSON blocks from text (use for local models served
#             with a custom --chat-template that does not support {{ tools }},
#             e.g. Gemma 4 via vLLM with --tool-call-parser gemma4)
LLM_TOOL_CALLING_MODE=native

# ── LangSmith tracing (optional) ─────────────────────────────────────────────
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=eda-agent-dev
LANGSMITH_ENABLED=false

# ── pgAdmin (docker-compose only) ─────────────────────────────────────────────
PGADMIN_EMAIL=admin@eda.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
