# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=eda_agent
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=eda_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── MiniMax LLM ──────────────────────────────────────────────────────────────
MINIMAX_API_KEY=sk-cp-HLVbwFFa2LIsMbKRSsm-qmUTFYS9GvvclT-MyVohuoEMTDY87aL_4UkuNZRqpvZVzQzBav1CaciE1lz9aVVdwc6kDvfETiuZSYj4JsJejdCCYoqJxig4drs
MINIMAX_GROUP_ID=488146745658241033
MINIMAX_BASE_URL=https://api.minimax.chat/v1
